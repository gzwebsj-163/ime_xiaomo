# Makefile.linux — xiaomo Linux 编译 (CentOS7 x86_64, devtoolset-9)
# 用法: scl enable devtoolset-9 "make -f Makefile.linux -j4"
CC = g++
CXX = g++
CFLAGS = -Wall -std=c++17 -g -Iinclude -D_POSIX_C_SOURCE=200809L
CXXFLAGS = $(CFLAGS)

C_SRCS = src/lexer.c src/parser.c src/ast.c src/vm.c src/vm_core.c src/vm_stack.c src/mo2kbc.c src/tensor.c src/nd_tensor.c src/weights.c src/debug_tool.c src/main.c
HW_SRCS = src/hw/hw_direct.c src/hw/hw_demo.c src/hw/hw_oem.c src/hw/hw_hex.c src/hw/hw_dev.c src/hw/hw_token.c src/hw/hw_fault.c src/hw/hw_core.c src/hw/hw_main.c src/hw/hw_wdbg.c src/hw/hw_flash.c src/hw/hw_pin.c src/hw/hw_dc.c src/hw/hw_dmc.c src/hw/hw_dmc_base.c
CPP_SRCS =

C_OBJS = $(C_SRCS:.c=.o)
HW_OBJS = $(HW_SRCS:.c=.o)
CPP_OBJS = $(CPP_SRCS:.cpp=.o)
OBJS = $(C_OBJS) $(HW_OBJS) $(CPP_OBJS)

TARGET = xiaomo

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ -lpthread

%.o: %.c
	$(CXX) $(CXXFLAGS) -x c++ -c $< -o $@

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)

.PHONY: all clean
