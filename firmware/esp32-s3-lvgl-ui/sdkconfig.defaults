CONFIG_IDF_TARGET="esp32s3"

# ---- Flash: 实测 16MB (esptool flash_id) ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- 自定义分区 (factory 4MB, 原工程只有 2MB) ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM: 实测 8MB 内置 (AP_3v3) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# ---- 主频 / 调度 ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# ---- 无 TLS（本机 IDF python 环境 gen_crt_bundle 会失败）----
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# ---- LVGL ----
CONFIG_LV_COLOR_DEPTH_16=y
# ⚠️ 关键：必须用 C 标准库 malloc，不能用 LVGL 内置 TLSF 堆
#    默认 LV_USE_BUILTIN_MALLOC 只给 64KB（CONFIG_LV_MEM_SIZE），
#    本 UI 约 225 个对象 + 每帧 draw task 直接撑爆 →
#    lv_malloc 返回 NULL 且默认无断言 → 写 NULL 指针 →
#    StoreProhibited / LoadProhibited 崩溃循环（已在真机实锤）。
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
# ⚠️ 第二道保险：LVGL 默认【不检查】malloc 返回值，分配失败会把 NULL 当合法指针用
#    （实测 StoreProhibited 写 0x0/野指针）。开启后失败立刻明确报错，不再静默踩内存。
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_SIMSUN_16_CJK=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n

# 抓屏探针用（shot_probe.c 的 lv_snapshot_take）。产品构建不受影响。
CONFIG_LV_USE_SNAPSHOT=y

# ── 2026-10-01 P0：中文字一个都上不了屏的根因 ──
# ① LV_USE_FONT_COMPRESSED 必须开：
#    main/fonts/*.c 是 lv_font_conv 生成的**压缩**位图（font_dsc.bitmap_format=1
#    = LV_FONT_FMT_TXT_COMPRESSED）。lv_font_fmt_txt.c 的取位图分支是
#      if(bitmap_format == PLAIN) {…} else { #if LV_USE_FONT_COMPRESSED … #else return NULL }
#    不开 ⇒ 压缩分支被 #if 掉 ⇒ **每个字形都返回 NULL ⇒ 一个字都不画**。
#    ⚠️ 危险的是 lv_font_get_glyph_dsc() 读的是 glyph_dsc 表，**不需要解压**，
#       所以「字形覆盖自检」照样 100% 全绿 —— 两条路径一条通一条不通。
#    ⇒ 判据必须覆盖解压这步，否则一个 100% 失败的渲染会被报成 100% 成功。
CONFIG_LV_USE_FONT_COMPRESSED=y

# ② LV_USE_LOG 必须开（至少 WARN）：
#    上面那个 return NULL 前有一句 LV_LOG_WARN("Compressed fonts is used but …")，
#    LV_USE_LOG=n 时**整段日志被编译掉**，故障完全静默 —— 日志里一个线索都没有。
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
