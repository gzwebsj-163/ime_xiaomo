# ---- 等待宿主注入一行输入, 然后取 64 维特征 ----
void rid : int = input_wait()
void j : int = 0
while ${j} < 64:
    void fv : int = feat(${j})
    x[${j}] = ${fv}
    void j : int = ${j} + 1

# ---- 隐层 16 (Q16 整数点积 + ReLU) ----
void j2 : int = 0
while ${j2} < 16:
    void acc : int = 0
    void i2 : int = 0
    while ${i2} < 64:
        void acc : int = ${acc} + x[${i2}] * W1[${j2} * 64 + ${i2}]
        void i2 : int = ${i2} + 1
    void acc : int = ${acc} + b1[${j2}]
    if ${acc} < 0:
        void acc : int = 0
    h[${j2}] = ${acc}
    void j2 : int = ${j2} + 1

# ---- 输出层 6 (logits, Q16 域) ----
void o : int = 0
while ${o} < 6:
    void acc2 : int = 0
    void k2 : int = 0
    while ${k2} < 16:
        void acc2 : int = ${acc2} + h[${k2}] * W2[${o} * 16 + ${k2}]
        void k2 : int = ${k2} + 1
    void acc2 : int = ${acc2} + b2[${o}]
    lg[${o}] = ${acc2}
    void o : int = ${o} + 1

# ---- argmax → 意图 id (0..5) ----
void ab : int = 0
void bv : int = lg[0]
void t : int = 1
while ${t} < 6:
    void cv : int = lg[${t}]
    if ${cv} > ${bv}:
        void bv : int = ${cv}
        void ab : int = ${t}
    void t : int = ${t} + 1
>> print >> "LOGITS=" >> lg[0] >> "," >> lg[1] >> "," >> lg[2] >> "," >> lg[3] >> "," >> lg[4] >> "," >> lg[5]
>> print >> "INTENT=" >> ${ab}
