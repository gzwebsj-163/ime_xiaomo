            t = 0 - ${t}
        t = ${t} - ${THR}
        if ${t} > 0:
            col[${x}] = col[${x}] + ${t}
            row[${y}] = row[${y}] + ${t}
        void x : int = ${x} + 1
    void y : int = ${y} + 1
