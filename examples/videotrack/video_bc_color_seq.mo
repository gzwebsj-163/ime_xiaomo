>> print >> "CX[28]: " >> ${nx} >> " DX[28]: " >> ${dx_}
>> print >> "CY[28]: " >> ${ny} >> " DY[28]: " >> ${dy_}
k = 0
while ${k} < ${W}:
    col[${k}] = 0
    k = ${k} + 1
k2 = 0
while ${k2} < ${H}:
    row[${k2}] = 0
    k2 = ${k2} + 1
y = 0
while ${y} < ${H}:
    x = 0
    while ${x} < ${W}:
        t_r = framesR[209728+${y}*${W}+${x}] - framesR[202496+${y}*${W}+${x}]
        t_g = framesG[209728+${y}*${W}+${x}] - framesG[202496+${y}*${W}+${x}]
        t_b = framesB[209728+${y}*${W}+${x}] - framesB[202496+${y}*${W}+${x}]
        if ${t_r} < 0:
            t_r = 0 - ${t_r}
        if ${t_g} < 0:
            t_g = 0 - ${t_g}
        if ${t_b} < 0:
            t_b = 0 - ${t_b}
        t = ${t_r} + ${t_g} + ${t_b}
        t = ${t} - ${T3}
        if ${t} > 0:
            col[${x}] = col[${x}] + ${t}
            row[${y}] = row[${y}] + ${t}
        x = ${x} + 1
    y = ${y} + 1
nx = 0
dx_ = 0
k3 = 0
while ${k3} < ${W}:
    nx = ${nx} + ${k3} * col[${k3}]
    dx_ = ${dx_} + col[${k3}]
    k3 = ${k3} + 1
ny = 0
dy_ = 0
k4 = 0
while ${k4} < ${H}:
    ny = ${ny} + ${k4} * row[${k4}]
    dy_ = ${dy_} + row[${k4}]
    k4 = ${k4} + 1
>> print >> "CX[29]: " >> ${nx} >> " DX[29]: " >> ${dx_}
>> print >> "CY[29]: " >> ${ny} >> " DY[29]: " >> ${dy_}
>> print >> "=== VIDEO BC COLOR DONE ===="
